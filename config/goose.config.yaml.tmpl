# Plantilla — renderizada por `just apply-config` con envsubst.
# Las variables ${...} se completan desde ~/.config/goose/secrets.env
GOOSE_TELEMETRY_ENABLED: ${GOOSE_TELEMETRY_ENABLED}
GOOSE_MAX_TURNS: ${GOOSE_MAX_TURNS}
GOOSE_GATEWAY_MAX_TURNS: ${GOOSE_GATEWAY_MAX_TURNS}
GOOSE_SUBAGENT_MAX_TURNS: ${GOOSE_SUBAGENT_MAX_TURNS}
GOOSE_CONTEXT_STRATEGY: ${GOOSE_CONTEXT_STRATEGY}
GOOSE_DISABLE_AUTO_SESSION_TITLES: '${GOOSE_DISABLE_AUTO_SESSION_TITLES}'

extensions:
  # ─── Built-in / platform (heredados de tu config actual) ────────────────────
  developer:           {enabled: true,  type: builtin,  name: developer,         display_name: Developer,           bundled: true, timeout: null}
  computercontroller:  {enabled: true,  type: builtin,  name: computercontroller,display_name: Computer Controller, bundled: true, timeout: 300}
  memory:              {enabled: true,  type: builtin,  name: memory,            display_name: Memory,              bundled: true, timeout: 300}
  todo:                {enabled: true,  type: platform, name: todo,              display_name: Todo,                bundled: true}
  apps:                {enabled: true,  type: platform, name: apps,              display_name: Apps,                bundled: true}
  extensionmanager:    {enabled: true,  type: platform, name: Extension Manager, display_name: Extension Manager,   bundled: true}
  analyze:             {enabled: true,  type: platform, name: analyze,           display_name: Analyze,             bundled: true}
  summon:              {enabled: true,  type: platform, name: summon,            display_name: Summon,              bundled: true}
  summarize:           {enabled: true,  type: platform, name: summarize,         display_name: Summarize,           bundled: true}
  tom:                 {enabled: true,  type: platform, name: tom,               display_name: Top Of Mind,         bundled: true}
  chatrecall:          {enabled: true,  type: platform, name: chatrecall,        display_name: Chat Recall,         bundled: true}
  code_execution:      {enabled: true,  type: platform, name: code_execution,    display_name: Code Mode,           bundled: true}
  skills:              {enabled: true,  type: platform, name: skills,            display_name: Skills,              bundled: true}

  # ─── MCPs externos existentes ───────────────────────────────────────────────
  moodle-mcp:
    name: Moodle UTEC
    type: stdio
    cmd: node
    args: [/home/fede/moodle-mcp-server/server.js]
    enabled: true
    timeout: 300
    # Credenciales migradas al keyring → el server.js debe leer vía MCP secrets
    # o vía variables que LINA inyecte en runtime. Por ahora se dejan vacías.
    envs:
      MOODLE_URL: https://ev1.utec.edu.uy/moodle
      MOODLE_USERNAME: german.dominguez
      MOODLE_PASSWORD_KEYRING: "lina:moodle:MOODLE_PASSWORD"

  google-calendar:
    name: Google Calendar
    type: stdio
    cmd: npx
    args: [-y, '@sudomcp/google-calendar-mcp', start]
    enabled: true
    timeout: 300
    envs:
      GOOGLE_OAUTH_CREDENTIALS: /home/fede/.config/google/credentials.json

  duckduckgo-search:
    name: duckduckgo-search
    type: stdio
    cmd: uvx
    args: [duckduckgo-mcp-server]
    enabled: true
    timeout: 300

  gns3:
    name: gns3
    display_name: GNS3
    type: stdio
    cmd: /media/fede/ADATA/GNS3/.venv/bin/gns3-mcp-server
    args: []
    enabled: true
    timeout: 60
    envs:
      GNS3_URL: http://127.0.0.1:3080
      GNS3_PROJECT: proyecto-router-on-stick-L3-puro
      GNS3_MCP_CREDENTIALS_FILE: /home/fede/.config/gns3-mcp-server/credentials.ini
      MCP_LOG_LEVEL: INFO
      MCP_MAX_CONCURRENT: '3'
      MCP_IDEMPOTENCY_TTL: '60'

  # ─── MCPs propios de LINA — Ola 1 ───────────────────────────────────────────
  lina-secrets:
    name: lina-secrets
    display_name: LINA Secrets
    description: Lee y guarda credenciales en el system-keyring (libsecret/kwallet).
    type: stdio
    enabled: true
    cmd: uv
    args: [--directory, /home/fede/lina/mcps/secrets, run, lina-secrets]
    envs:
      LINA_KEYRING_SERVICE: ${LINA_KEYRING_SERVICE}
    timeout: 30

  lina-fs-safe:
    name: lina-fs-safe
    display_name: LINA FS Safe
    description: Filesystem con allowlist rígida y audit log.
    type: stdio
    enabled: true
    cmd: uv
    args: [--directory, /home/fede/lina/mcps/fs-safe, run, lina-fs-safe]
    envs:
      LINA_FS_ALLOWLIST: ${LINA_FS_ALLOWLIST}
    timeout: 60

  lina-shell-policy:
    name: lina-shell-policy
    display_name: LINA Shell Policy
    description: Ejecuta comandos con policy (rechaza destructivos y sudo sin flag).
    type: stdio
    enabled: true
    cmd: uv
    args: [--directory, /home/fede/lina/mcps/shell-policy, run, lina-shell-policy]
    envs:
      LINA_SHELL_ALLOW_SUDO: ${LINA_SHELL_ALLOW_SUDO}
      LINA_SHELL_TIMEOUT_SEC: ${LINA_SHELL_TIMEOUT_SEC}
    timeout: 120

  lina-systemd-user:
    name: lina-systemd-user
    display_name: LINA Systemd User
    description: Consulta y controla unidades de systemd --user del propio LINA.
    type: stdio
    enabled: true
    cmd: uv
    args: [--directory, /home/fede/lina/mcps/systemd-user, run, lina-systemd-user]
    envs: {}
    timeout: 30

  lina-moodle:
    name: lina-moodle
    display_name: LINA Moodle
    description: Interactúa con cuestionarios de Moodle — iniciar intentos, obtener preguntas y opciones, responder preguntas sin finalizar intentos.
    type: stdio
    enabled: true
    cmd: uv
    args: [--directory, /home/fede/lina/mcps/moodle, run, lina-moodle]
    envs:
      MOODLE_URL: https://ev1.utec.edu.uy/moodle
      MOODLE_USERNAME: german.dominguez
      MOODLE_PASSWORD_KEYRING: "lina:moodle:MOODLE_PASSWORD"
    timeout: 120

  lina-gitlab:
    name: lina-gitlab
    display_name: LINA GitLab UTEC
    description: Acceso a proyectos, issues, MRs y pipelines de GitLab UTEC (git.utec.edu.uy).
    type: stdio
    enabled: true
    cmd: uv
    args: [--directory, /home/fede/lina/mcps/gitlab, run, lina-gitlab]
    envs:
      GITLAB_URL: https://git.utec.edu.uy
      GITLAB_TOKEN_KEYRING: "lina:gitlab:GITLAB_TOKEN"
    timeout: 60

providers:
  custom_deepseek:
    enabled: true
    model: deepseek-v4-flash
    configured: true
active_provider: custom_deepseek
GOOSE_THINKING_EFFORT: false

gateway_configs:
  - gateway_type: telegram
    max_sessions: 0
gateway_pending_codes: []
# gateway_pairings se preserva por apply-config desde el config anterior.
gateway_pairings: []
