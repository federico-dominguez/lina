[Unit]
Description=LINA Pipeline — Cierre nocturno
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=fede
Environment=PYTHONUNBUFFERED=1
Environment=LINA_DB_URL=postgresql://lina:lina_dev@localhost:5432/lina
ExecStart=/usr/bin/python3 /home/fede/lina/infrastructure/pipeline/rutina.py evening
StandardOutput=journal
StandardError=journal
