# syntax=docker/dockerfile:1
# Gemma — Tester (copia de Cline, personalidad de testing)
# Usa el mismo binario forkeado que LINA/Cline.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        libsecret-1-0 \
        libdbus-1-3 \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

ENV UV_VERSION=0.4.18
RUN pip3 install --no-cache-dir uv==${UV_VERSION} --break-system-packages

WORKDIR /app

COPY mcps/ mcps/
RUN for d in secrets fs-safe shell-policy systemd-user moodle lina-db; do \
        if [ -d "mcps/$d" ]; then \
            echo "→ uv sync mcps/$d" && cd "mcps/$d" && uv sync --no-dev --quiet && cd /app; \
        fi; \
    done

COPY config/ config/
COPY bin/ bin/

ARG AGENT_PERSONALITY=gemma
COPY deploy/docker/AGENTS.${AGENT_PERSONALITY}.md /app/AGENTS.md
COPY deploy/docker/AGENTS.${AGENT_PERSONALITY}.md /tmp/AGENTS.md

ARG GOOSED_BIN=bin/goosed-linux-amd64
COPY ${GOOSED_BIN} /usr/local/bin/goosed
RUN pip3 install --no-cache-dir --break-system-packages asyncpg
RUN chmod +x /usr/local/bin/goosed

EXPOSE 3000
ENV LINA_ENV=docker

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD curl -sfk -H "x-secret-key: ${GOOSE_SERVER__SECRET_KEY:-}" https://localhost:3000/status || exit 1

CMD ["/usr/local/bin/goosed", "agent"]
