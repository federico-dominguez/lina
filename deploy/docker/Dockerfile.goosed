# syntax=docker/dockerfile:1
# LINA — Runtime image (goosed + MCPs Python)
#
# El binario goosed es un artefacto externo (build custom del fork patched).
# Debe estar disponible en el contexto de build.
#
# Uso:
#   # Copiar el binario al contexto antes de buildear:
#   cp ~/goosed_patched bin/goosed-linux-amd64
#   docker build -f deploy/docker/Dockerfile.goosed -t lina-goosed:latest .
#
# Build arg:
#   GOOSED_BIN   ruta relativa al binario dentro del build context
#                (default: bin/goosed-linux-amd64)

FROM ubuntu:24.04

# ─── sistema ────────────────────────────────────────────────────────────────
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        libsecret-1-0 \
        libdbus-1-3 \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

# ─── uv ─────────────────────────────────────────────────────────────────────
ENV UV_VERSION=0.4.18
RUN pip3 install --no-cache-dir uv==${UV_VERSION} --break-system-packages

# ─── app ──────────────────────────────────────────────────────────────────────
WORKDIR /app

# Copiar MCPs y sincronizar dependencias (sin dev)
COPY mcps/ mcps/
RUN for d in secrets fs-safe shell-policy systemd-user moodle lina-db; do \
        if [ -d "mcps/$d" ]; then \
            echo "→ uv sync mcps/$d" && cd "mcps/$d" && uv sync --no-dev --quiet && cd /app; \
        fi; \
    done

COPY config/ config/
COPY bin/ bin/


# ─── Agent personality ────────────────────────────────────────────────────────
# /app: CWD del proceso goosed (carga AGENTS al iniciar)
# /tmp: CWD de las sesiones creadas via agent/start (carga AGENTS por sesión)
ARG AGENT_PERSONALITY=lina
COPY deploy/docker/AGENTS.${AGENT_PERSONALITY}.md /app/AGENTS.md
COPY deploy/docker/AGENTS.${AGENT_PERSONALITY}.md /tmp/AGENTS.md

# ─── goosed binary ────────────────────────────────────────────────────────────
ARG GOOSED_BIN=bin/goosed-linux-amd64
COPY ${GOOSED_BIN} /usr/local/bin/goosed
# ─── Python deps (not shared via venvs) ──────────────────────────────────────
RUN pip3 install --no-cache-dir --break-system-packages asyncpg

RUN chmod +x /usr/local/bin/goosed

# ─── runtime ──────────────────────────────────────────────────────────────────
EXPOSE 3000
ENV LINA_ENV=docker

# Health check vía el endpoint HTTP de goosed (usa GOOSE_PORT si está definida, default 3000)
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD curl -sfk -H "x-secret-key: ${GOOSE_SERVER__SECRET_KEY:-}" "https://localhost:${GOOSE_PORT:-3000}/status" || exit 1

# Solo el servidor HTTP. El gateway Telegram corre en lina-gateway (Docker separado).
CMD ["/usr/local/bin/goosed", "agent"]
