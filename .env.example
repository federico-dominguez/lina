# Copia este archivo a ~/.config/goose/secrets.env y completa los valores.
# chmod 600 ~/.config/goose/secrets.env

# ─── Provider DeepSeek ────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=<tu-deepseek-api-key>

# ─── Gateway Telegram ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<bot-id>:<token-de-botfather>

# ─── Goose runtime ────────────────────────────────────────────────────────────
GOOSED_BINARY=/home/fede/lina/bin/goosed
GOOSE_MAX_TURNS=1000
GOOSE_GATEWAY_MAX_TURNS=200
GOOSE_SUBAGENT_MAX_TURNS=200
GOOSE_CONTEXT_STRATEGY=summarize
GOOSE_TELEMETRY_ENABLED=false
GOOSE_DISABLE_AUTO_SESSION_TITLES=true

# ─── MCP secrets (keyring) ────────────────────────────────────────────────────
# El servicio bajo el que se guardan las credenciales en libsecret/kwallet.
LINA_KEYRING_SERVICE=lina

# ─── MCP fs-safe ──────────────────────────────────────────────────────────────
# Allowlist separada por ':' (rutas absolutas, sin trailing slash).
LINA_FS_ALLOWLIST=/home/fede/lina:/home/fede/Documents:/home/fede/IdeaProjects

# ─── MCP shell-policy ─────────────────────────────────────────────────────────
# Si vale '1' se permite ejecutar comandos marcados como 'sudo' por la policy.
# Mantener en '0' salvo durante una ventana de mantenimiento explícita.
LINA_SHELL_ALLOW_SUDO=0
LINA_SHELL_TIMEOUT_SEC=60
